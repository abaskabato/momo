# Copy to .env, or run `npm run setup` to fill this in with checks.

# --- Required ---------------------------------------------------------------
# Encrypts every user's data. Generate once and never change it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MOMO_MASTER_KEY=
# Any model, as provider/model, plus that provider's key:
#   gemini/gemini-flash-latest       GEMINI_API_KEY   (free key: aistudio.google.com)
#   anthropic/claude-opus-5-5        ANTHROPIC_API_KEY
#   openai/<model>                   OPENAI_API_KEY
#   openrouter/<vendor>/<model>      OPENROUTER_API_KEY
#   groq/<model>                     GROQ_API_KEY
#   ollama/<model>                   (local, no key)
MOMO_MODEL=gemini/gemini-flash-latest
GEMINI_API_KEY=
# From @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# --- Recommended ------------------------------------------------------------
# A public https address for this server. Enables login/card links on phones,
# the Telegram webhook, and WhatsApp. Without it Telegram is long-polled.
PUBLIC_URL=
REDIS_URL=redis://127.0.0.1:6379

# --- Where Momo works -------------------------------------------------------
# Unset: websites only, in a private headless browser (many people).
# local: this computer's screen via agent-desktop; any app (only you).
# cloud: a fresh Linux desktop container per errand (many people; needs Docker
#        and `docker build -f Dockerfile.desktop -t momo-desktop .`).
MOMO_DESKTOP=

# --- Optional ---------------------------------------------------------------
# MOMO_ANSWER_MODEL=           cheaper model for plain questions
# TELEGRAM_WEBHOOK_SECRET=     generated by setup
# WHATSAPP_PHONE_NUMBER_ID= WHATSAPP_ACCESS_TOKEN= WHATSAPP_APP_SECRET= WHATSAPP_VERIFY_TOKEN=
# BLAND_API_KEY=               phone calls when a website can't do it
# MOMO_EMAIL_DOMAIN= INBOUND_EMAIL_SECRET=   a Momo email address per person
# MOMO_BROWSER=desktop         drive your real Chrome via agent-desktop
# MOMO_SINGLE_OWNER=1          only the first person to text can use it
# MOMO_WORKERS=8               errands at once
# PORT=8787
