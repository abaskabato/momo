# Copy to .env, or run `npm run setup` to fill this in with checks.

# --- Required ---------------------------------------------------------------
# Encrypts every user's data. Generate once and never change it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MOMO_MASTER_KEY=
# Any model, as provider/model, plus that provider's key:
#   gemini/gemini-flash-latest       GEMINI_API_KEY   (free key: aistudio.google.com)
#   anthropic/claude-opus-5-5        ANTHROPIC_API_KEY
#   openai/<model>                   OPENAI_API_KEY
#   openrouter/<vendor>/<model>      OPENROUTER_API_KEY
#   groq/<model>                     GROQ_API_KEY
#   ollama/<model>                   (local, no key)
MOMO_MODEL=gemini/gemini-flash-lite-latest
GEMINI_API_KEY=
# A model on this computer (Ollama), with a frontier model for the steps beyond it:
#   MOMO_MODEL=ollama/auto           (a Gemma 4 size for this computer, downloaded by Momo)
#   MOMO_MODEL=ollama/qwen3.5:4b
#   MOMO_FRONTIER_MODEL=anthropic/claude-opus-5-5   (plus its key) takes over when the local model is stuck,
#                                                   and checks before finishing or spending; leave unset for local only
# MOMO_LOCAL_CONTEXT=16384      tokens of context Ollama gives the model (Ollama's own default is often 4k: too small)
# MOMO_LOCAL_THINK=1            let a local model think before each step (slower; off by default)
# MOMO_LOCAL_KEEP_ALIVE=30m     how long Ollama keeps the model loaded between steps
# MOMO_LITE=1 | 0               force the light loop on or off (default: on for small and local models)
# MOMO_EFFORT=medium            how hard Claude thinks at each step: low | medium | high | xhigh | max
# From @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=

# --- Recommended ------------------------------------------------------------
# A public https address for this server. Enables login/card links on phones,
# the Telegram webhook, and WhatsApp. Without it Telegram is long-polled.
PUBLIC_URL=
# Momo's website (apps/web on Vercel) relays secure links to phones when this
# computer has no public address. The setup page fills these in.
# MOMO_RELAY_URL=https://your-momo.vercel.app
# MOMO_RELAY_TOKEN=

# --- Storage ----------------------------------------------------------------
# Unset: state is saved in one file, $MOMO_HOME/store.json (default ~/.momo).
# Set it for a server shared by many people.
# REDIS_URL=redis://127.0.0.1:6379
# MOMO_HOME=~/.momo

# --- Where Momo works -------------------------------------------------------
# Unset: websites only, in a private headless browser (many people).
# local: this computer's screen via agent-desktop; any app (only you).
# cloud: a fresh Linux desktop container per errand (many people; needs Docker
#        and `docker build -f Dockerfile.desktop -t momo-desktop .`).
MOMO_DESKTOP=
# full: also read files and run commands on this computer (only you can use
# it). Looking is free; every change is shown to you and waits for your YES.
# MOMO_ACCESS=full

# --- Optional ---------------------------------------------------------------
# MOMO_ANSWER_MODEL=           cheaper model for plain questions
# TELEGRAM_WEBHOOK_SECRET=     generated by setup
# WHATSAPP_PHONE_NUMBER_ID= WHATSAPP_ACCESS_TOKEN= WHATSAPP_APP_SECRET= WHATSAPP_VERIFY_TOKEN=
# BLAND_API_KEY=               phone calls when a website can't do it
# MOMO_EMAIL_DOMAIN= INBOUND_EMAIL_SECRET=   a Momo email address per person
# MOMO_BROWSER=hidden          on your own computer Momo opens a visible browser window by default; this hides it
# MOMO_SIGN_INS=none           Momo copies your Chrome (else Edge) sign-ins and saved passwords into its own browser once;
#                              none keeps it separate, chrome or edge picks which one
# MOMO_AWAKE=off               on your own computer Momo stops it from going to sleep; off leaves it be
# MOMO_MAINTENANCE=03:00-05:00 Windows: the nightly window when the computer may sleep, update or restart
#                              (it wakes itself at the end); off keeps it awake around the clock
# MOMO_SPEND_LIMIT=200         Momo doesn't stop to ask; the one exception is a single purchase above this many dollars
#                              (none = no limit)
# MOMO_ASK=money               ask for a YES before purchases, messages, calls and deletions (default: text and done)
# MOMO_ASK=bookings            ask for a YES before free reservations and appointments too (default: just make them)
# MOMO_ASK=commands            with MOMO_ACCESS=full, ask before every command that changes something
#                              (default: ask only before deleting, uninstalling or replacing a file)
# MOMO_BROWSER=desktop         drive your real Chrome via agent-desktop
# MOMO_SINGLE_OWNER=1          only the first person to text can use it
# MOMO_WORKERS=8               errands at once
# PORT=8787
# MOMO_GATEWAY_TOKEN=          on a Mac: pass texts between its Messages app and the website's relay (see docs/SETUP.md)

# --- Website only (apps/web on Vercel): charging for the shared AI and calls ---
# STRIPE_SECRET_KEY=        # with it, Momos on the site's shared AI are free for a week, then pay monthly
# MOMO_TRIAL_DAYS=7
# MOMO_PRICE_CENTS=1500     # $15 a month
