# A cloud computer for one person's errand: a real Linux desktop (X11 +
# accessibility bus) with everyday apps, driven by vercel-labs/agent-desktop
# the way a person at the screen would use it. One container per errand.
#
#   docker build -f Dockerfile.desktop -t momo-desktop .
FROM ubuntu:24.04

ARG AGENT_DESKTOP_VERSION=1.0.2
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb openbox dbus dbus-x11 at-spi2-core \
      gnome-calculator gnome-text-editor \
      fonts-dejavu-core ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# agent-desktop's native Linux binary, pinned.
RUN curl -fsSL "https://registry.npmjs.org/agent-desktop/-/agent-desktop-${AGENT_DESKTOP_VERSION}.tgz" | tar -xz -C /tmp \
    && install -m 0755 "/tmp/package/bin/agent-desktop-linux-$(uname -m | sed 's/x86_64/x64/;s/aarch64/arm64/')" /usr/local/bin/agent-desktop \
    && rm -rf /tmp/package

RUN useradd --create-home --shell /bin/bash momo && install -d -m 0700 -o momo -g momo /home/momo/.agent-desktop
COPY --chmod=0755 desktop/start.sh /usr/local/bin/momo-desktop
USER momo
WORKDIR /home/momo
ENV DISPLAY=:99 \
    DBUS_SESSION_BUS_ADDRESS=unix:path=/tmp/momo-bus \
    XDG_RUNTIME_DIR=/tmp/momo-runtime \
    NO_AT_BRIDGE=0 \
    GTK_A11Y=atspi
CMD ["momo-desktop"]
